{
  "name": "@agentrewind/cli",
  "version": "0.1.3",
  "description": "AgentRewind command-line tools for inspecting, diffing, packing, and unpacking sessions.",
  "type": "module",
  "keywords": [
    "llm",
    "agents",
    "replay",
    "cli",
    "debugging"
  ],
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "agentrewind": "./dist/index.js",
    "arw": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --target node20 --tsconfig ../../tsconfig.base.json",
    "prepack": "pnpm build"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@agentrewind/codec-anthropic": "workspace:*",
    "@agentrewind/codec-openai": "workspace:*",
    "@agentrewind/codec-openrouter": "workspace:*",
    "@agentrewind/core": "workspace:*",
    "@anthropic-ai/sdk": "^0.100.1",
    "commander": "^15.0.0",
    "openai": "^6.39.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/faizancodes/agent-rewind.git"
  },
  "homepage": "https://github.com/faizancodes/agent-rewind#readme",
  "bugs": {
    "url": "https://github.com/faizancodes/agent-rewind/issues"
  }
}
