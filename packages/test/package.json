{
  "name": "@agentrewind/test",
  "version": "0.1.0",
  "description": "AgentRewind test helpers for asserting recorded replay sessions.",
  "type": "module",
  "keywords": [
    "llm",
    "agents",
    "replay",
    "testing"
  ],
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --target node20 --tsconfig ../../tsconfig.base.json",
    "prepack": "pnpm build"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@agentrewind/core": "workspace:*"
  },
  "devDependencies": {}
}
