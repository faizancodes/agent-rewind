{
  "name": "@agentrewind/test",
  "version": "0.1.1",
  "description": "AgentRewind test helpers for asserting recorded replay sessions.",
  "type": "module",
  "keywords": [
    "llm",
    "agents",
    "replay",
    "testing"
  ],
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --target node20 --tsconfig ../../tsconfig.base.json",
    "prepack": "pnpm build"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@agentrewind/core": "workspace:*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/faizancodes/agent-rewind.git"
  },
  "homepage": "https://github.com/faizancodes/agent-rewind#readme",
  "bugs": {
    "url": "https://github.com/faizancodes/agent-rewind/issues"
  }
}
