{
  "name": "@agentrewind/codec-openai",
  "version": "0.1.2",
  "description": "OpenAI-compatible Chat Completions codec for AgentRewind.",
  "type": "module",
  "keywords": [
    "openai",
    "chat-completions",
    "llm",
    "agents",
    "replay"
  ],
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --target node20 --tsconfig ../../tsconfig.base.json",
    "prepack": "pnpm build"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "openai": "*"
  },
  "dependencies": {
    "@agentrewind/core": "workspace:*"
  },
  "devDependencies": {
    "openai": "^6.39.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/faizancodes/agent-rewind.git"
  },
  "homepage": "https://github.com/faizancodes/agent-rewind#readme",
  "bugs": {
    "url": "https://github.com/faizancodes/agent-rewind/issues"
  }
}
